{
  "name": "normal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build --cache-dir=.turbo/cache && bun run inspect:bundles",
    "db:check": "bun run --cwd packages/db db:check",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:migrate-public-data": "bun run --cwd packages/db db:migrate-public-data",
    "db:record-gap": "bun run --cwd packages/db db:record-gap",
    "dev": "turbo run dev --filter=@whatsapp-mcp/api --filter=@whatsapp-mcp/web --cache-dir=.turbo/cache",
    "dev:tunnel": "cloudflared tunnel run dev",
    "deploy:smoke": "bun scripts/mcp-smoke-credentials.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "infra:validate": "bun scripts/validate-infrastructure.ts",
    "inspect:bundles": "bun scripts/inspect-production-bundles.ts",
    "launch:gate": "bun scripts/launch-gate.ts",
    "release:public-api": "bun scripts/public-api-release-gate.ts",
    "ingestion:replay": "bun scripts/request-webhook-replay.ts",
    "lint": "turbo run lint --cache-dir=.turbo/cache && biome check .sandcastle scripts",
    "manifests:validate": "bun scripts/validate-deployment-manifests.ts",
    "observability:canary": "bun scripts/send-observability-canary.ts",
    "observability:validate": "bun scripts/validate-observability.ts",
    "recovery:drill": "bun scripts/run-recovery-drill.ts",
    "test": "bun test scripts/*.test.ts && turbo run test --cache-dir=.turbo/cache",
    "typecheck": "tsc --noEmit -p tsconfig.tools.json && turbo run typecheck --cache-dir=.turbo/cache",
    "validate:infra": "bun scripts/validate-kms-infrastructure.ts && tofu -chdir=infra/aws fmt -check && tofu -chdir=infra/aws init -backend=false -input=false && tofu -chdir=infra/aws validate",
    "sandcastle": "bun .sandcastle/main.mts",
    "sandcastle:build-image": "sandcastle docker build-image",
    "sandcastle:verify-gh": "bun .sandcastle/verify-gh.ts"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@aws-sdk/client-secrets-manager": "3.1099.0",
    "@biomejs/biome": "2.2.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "turbo": "2.10.7",
    "typescript": "^5",
    "zod": "^4.4.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
