# `.dev.vars` is only for values that must not be committed. Non-secret local
# configuration belongs in `wrangler.jsonc` under `vars`.

# These identifiers are not credentials, but deployment provisions them through
# the secret-binding pipeline so they remain environment-specific.
KMS_CONTENT_ROOT_KEY_ARN=arn:aws:kms:us-east-1:111122223333:key/replace-with-content-root-key-id
KMS_DELETION_COORDINATOR_KEY_ARN=arn:aws:kms:us-east-1:111122223333:key/replace-with-deletion-coordinator-key-id

# Short-lived credentials for the ContentRuntimeRole; never commit real values.
AWS_ACCESS_KEY_ID=replace-with-temporary-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-temporary-secret-access-key
AWS_SESSION_TOKEN=replace-with-temporary-session-token

# Dedicated marker-key HMAC secret; generate independently with openssl rand -hex 32.
DELETION_MARKER_HMAC_SECRET=replace-with-dedicated-32-byte-hex-secret

# Dedicated authorization-bound send fingerprint HMAC key.
SEND_FINGERPRINT_HMAC_SECRET=replace-with-dedicated-32-byte-hex-secret

# Authenticates the non-interactive deployed smoke command only.
SMOKE_CHECK_SECRET=replace-with-dedicated-32-byte-hex-secret

# Dedicated platform-wide WhatsApp Number reservation HMAC secret.
# Generate independently with openssl rand -hex 32.
WHATSAPP_NUMBER_RESERVATION_HMAC_SECRET=replace-with-dedicated-32-byte-hex-secret

# Signs short-lived, authorization-bound MCP pagination cursors.
# Generate independently with openssl rand -hex 32.
MCP_CURSOR_HMAC_SECRET=replace-with-dedicated-32-byte-hex-secret

# Purpose-specific HMAC for API Key credential digests.
# Generate independently with openssl rand -hex 32.
API_KEY_HMAC_SECRET=replace-with-dedicated-32-byte-hex-secret

# Clerk deployment material.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----
replace-with-clerk-jwt-public-key
-----END PUBLIC KEY-----"
CLERK_SECRET_KEY=sk_test_replace-with-clerk-backend-secret
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace-with-clerk-webhook-signing-secret

# Encrypts short-lived authorization requests handed to the web consent UI.
# Generate independently with openssl rand -hex 32.
OAUTH_PROTOCOL_ENCRYPTION_KEY=replace-with-dedicated-32-byte-hex-secret
