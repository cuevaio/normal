{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "GitHub OIDC broker for rotating production Deletion Coordinator credentials.",
  "Parameters": {
    "DeletionCoordinatorRoleArn": {
      "AllowedPattern": "^arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$",
      "Description": "Exact DeletionCoordinatorRole ARN this broker may assume.",
      "Type": "String"
    },
    "EmergencyAssumerArn": {
      "AllowedPattern": "^arn:aws:iam::[0-9]{12}:(role|user)/[A-Za-z0-9+=,.@_/-]+$",
      "Description": "Human bootstrap authority retained for incident recovery.",
      "Type": "String"
    },
    "GitHubEnvironment": {
      "AllowedPattern": "^[A-Za-z0-9_-]+$",
      "Default": "production",
      "Type": "String"
    },
    "GitHubOidcProviderArn": {
      "AllowedPattern": "^arn:aws(-[a-z]+)?:iam::[0-9]{12}:oidc-provider/token\\.actions\\.githubusercontent\\.com$",
      "Type": "String"
    },
    "GitHubRepositoryIdentity": {
      "AllowedPattern": "^[A-Za-z0-9_.-]+@[0-9]+/[A-Za-z0-9_.-]+@[0-9]+$",
      "Default": "cuevaio@83598208/normal@1317490924",
      "Type": "String"
    }
  },
  "Resources": {
    "DeletionCredentialBrokerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": {
                    "Fn::Sub": "repo:${GitHubRepositoryIdentity}:environment:${GitHubEnvironment}"
                  }
                }
              },
              "Effect": "Allow",
              "Principal": {
                "Federated": { "Ref": "GitHubOidcProviderArn" }
              }
            },
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": { "AWS": { "Ref": "EmergencyAssumerArn" } }
            }
          ],
          "Version": "2012-10-17"
        },
        "Description": "Rotates short-lived Deletion Coordinator credentials without tenant-content authority.",
        "ManagedPolicyArns": [],
        "MaxSessionDuration": 3600,
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": "sts:AssumeRole",
                  "Effect": "Allow",
                  "Resource": { "Ref": "DeletionCoordinatorRoleArn" }
                }
              ],
              "Version": "2012-10-17"
            },
            "PolicyName": "AssumeDeletionCoordinatorRole"
          }
        ],
        "RoleName": "whatsapp-mcp-production-deletion-credential-broker"
      }
    }
  },
  "Outputs": {
    "DeletionCredentialBrokerRoleArn": {
      "Value": {
        "Fn::GetAtt": ["DeletionCredentialBrokerRole", "Arn"]
      }
    }
  }
}
