{
  "name": "@whatsapp-mcp/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api-key": "./src/api-key.ts",
    "./connection-health": "./src/connection-health.ts",
    "./connection-setup": "./src/connection-setup.ts",
    "./config": "./src/config.ts",
    "./connectivity": "./src/connectivity.ts",
    "./database": "./src/database.ts",
    "./group": "./src/group.ts",
    "./directory": "./src/directory.ts",
    "./migrations": "./src/migrations.ts",
    "./mcp-authorization": "./src/mcp-authorization.ts",
    "./mcp-tool": "./src/mcp-tool.ts",
    "./message-retention": "./src/message-retention.ts",
    "./message-search": "./src/message-search.ts",
    "./onboarding-profile": "./src/onboarding-profile.ts",
    "./personal-account": "./src/personal-account.ts",
    "./readiness": "./src/readiness.ts",
    "./recovery-migrations": "./src/recovery-migrations.ts",
    "./recovery-verifier": "./src/recovery-verifier.ts",
    "./recovery-source-point": "./src/recovery-source-point.ts",
    "./recipient-exclusion": "./src/recipient-exclusion.ts",
    "./request-connection": "./src/request-connection.ts",
    "./restricted-runtime-config": "./src/restricted-runtime-config.ts",
    "./schema": "./src/schema.ts",
    "./restore": "./src/restore.ts",
    "./send": "./src/send.ts",
    "./stored-media": "./src/stored-media.ts",
    "./account-insights": "./src/account-insights.ts",
    "./activity-log": "./src/activity-log.ts",
    "./webhook-event": "./src/webhook-event.ts",
    "./webhook-ingress": "./src/webhook-ingress.ts",
    "./webhook-replay": "./src/webhook-replay.ts",
    "./whatsapp-connection": "./src/whatsapp-connection.ts"
  },
  "scripts": {
    "build": "bun build src/api-key.ts src/config.ts src/connection-health.ts src/connection-setup.ts src/connectivity.ts src/database.ts src/directory.ts src/group.ts src/mcp-authorization.ts src/mcp-tool.ts src/message-retention.ts src/message-search.ts src/migrations.ts src/onboarding-profile.ts src/personal-account.ts src/readiness.ts src/recovery-migrations.ts src/recovery-source-point.ts src/recovery-verifier.ts src/recipient-exclusion.ts src/request-connection.ts src/restricted-runtime-config.ts src/restore.ts src/schema.ts src/send.ts src/stored-media.ts src/account-insights.ts src/activity-log.ts src/record-ingestion-gap-cli.ts src/schema-version.ts src/webhook-event.ts src/webhook-ingress.ts src/webhook-replay.ts src/whatsapp-connection.ts --outdir dist --target bun",
    "db:check": "bun src/check-cli.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:migrate-public-data": "bun src/migrate-public-data-cli.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "db:record-gap": "bun src/record-ingestion-gap-cli.ts",
    "lint": "biome check .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@whatsapp-mcp/domain": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "effect": "3.22.1",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@types/bun": "^1.3.14",
    "@types/pg": "8.20.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5"
  }
}
